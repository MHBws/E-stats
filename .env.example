# =============================================================================
# .env.example — Variáveis de ambiente padrão para DESENVOLVIMENTO LOCAL
# -----------------------------------------------------------------------------
# O QUE: Modelo versionado com todas as variáveis que a aplicação espera.
# POR QUE: O .env real é ignorado pelo Git (pode conter segredos); este arquivo
#          documenta o contrato e permite setup rápido: `cp .env.example .env`.
# ATENÇÃO: Valores abaixo são FAKE/DEV. Nunca use em produção.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
# Porta HTTP/WebSocket da API.
PORT=3000
# 0.0.0.0 permite acesso externo ao container; no host pode ser localhost.
HOST=0.0.0.0
# Nível de log do Fastify/Pino (trace | debug | info | warn | error).
LOG_LEVEL=debug

# --- PostgreSQL --------------------------------------------------------------
# Lidas tanto pela API quanto pela imagem oficial do Postgres (criação do banco).
# No docker-compose, POSTGRES_HOST é sobrescrito para "db" no serviço api.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=estats
POSTGRES_PASSWORD=estats_dev_password
POSTGRES_DB=estats_dev

# --- Redis -------------------------------------------------------------------
# No docker-compose, REDIS_HOST é sobrescrito para "redis" no serviço api.
REDIS_HOST=localhost
REDIS_PORT=6379
# Vazio em dev (Redis local sem autenticação).
REDIS_PASSWORD=

# --- Provedores de dados de Esports (chaves FAKE) ----------------------------
# Cito: fonte primária de eventos ao vivo (baixa latência).
CITO_API_KEY=fake_cito_api_key_dev_0000000000
# PandaScore: dados de partidas, times, torneios e fallback.
PANDASCORE_API_KEY=fake_pandascore_api_key_dev_0000000000
